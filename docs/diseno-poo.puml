@startuml diseno-poo
' Regenerar PNG (desde docs/):
'   plantuml -tpng diseno-poo.puml
'   docker run --rm -v "$PWD":/data plantuml/plantuml -tpng /data/diseno-poo.puml
'   curl -sS -X POST --data-binary @diseno-poo.puml https://kroki.io/plantuml/png -o diseno-poo.png

hide empty members
hide circle
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 45
skinparam class {
  BorderThickness 1.5
  FontStyle bold
  HeaderBackgroundColor<<impl>> #EBF4FA
  BackgroundColor<<impl>> #EBF4FA
  BorderColor<<impl>> #0076BA
  FontColor<<impl>> #0076BA
  HeaderBackgroundColor<<todo>> #F8E6E4
  BackgroundColor<<todo>> #F8E6E4
  BorderColor<<todo>> #B51700
  FontColor<<todo>> #B51700
}
skinparam arrow {
  Color #0076BA
  Thickness 1.2
}
skinparam stereotype {
  CBackgroundColor<<impl>> #0076BA
  CBackgroundColor<<todo>> #B51700
}

title Diseño POO — pipeline de noticias

class PipelineLaboratorio <<impl>>

class DescubridorGoogleNews <<impl>>
class FabricaCapturadores <<impl>>
class LimpiadorHTML <<impl>>
class CapturadorFuente <<impl>> {
  {abstract}
}
class CapturadorBioBio <<impl>>
class CapturadorCooperativa <<impl>>
class CapturadorLaTercera <<impl>>
class CapturadorGenerico <<impl>>

class ExtractorLLM <<impl>> {
  {abstract}
}
class ExtractorGemini <<impl>>
class ValidadorJSON <<impl>>
class EscritorObsidian <<todo>>
class ExploradorDatos <<todo>>

PipelineLaboratorio --> DescubridorGoogleNews
PipelineLaboratorio --> FabricaCapturadores
PipelineLaboratorio --> LimpiadorHTML
PipelineLaboratorio --> ExtractorLLM
PipelineLaboratorio --> ValidadorJSON
PipelineLaboratorio --> EscritorObsidian
PipelineLaboratorio --> ExploradorDatos

FabricaCapturadores --> CapturadorFuente

CapturadorBioBio --|> CapturadorFuente
CapturadorCooperativa --|> CapturadorFuente
CapturadorLaTercera --|> CapturadorFuente
CapturadorGenerico --|> CapturadorFuente
ExtractorGemini --|> ExtractorLLM

legend right
  |= Color |= Significado |
  | <#EBF4FA> azul | Implementado (captura + Gemini/JSON) |
  | <#F8E6E4> rojo | Interfaz TODO(alumno) |
endlegend

@enduml
